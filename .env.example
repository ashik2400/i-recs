# --- Paths ---
DATA_DIR=./data/ml-25m
OUTPUT_DIR=./outputs

# --- Spark ---
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=8g
SPARK_SHUFFLE_PARTITIONS=200

# --- LLM: template (default, no key) | ollama | anthropic | openai | groq ---
# empty LLM_PROVIDER + GROQ_API_KEY set -> groq (openai/gpt-oss-120b)
# anthropic needs `pip install anthropic`; defaults: ollama llama3.2:3b, anthropic claude-opus-5-5
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
GROQ_API_KEY=

# --- Cloud (only if using AWS/GCP; leave blank otherwise) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=